# ===== Servicio temporal en Railway (mismo repo) para INVESTIGAR estrategias de EMA =====
# No opera ni envia senales: descarga historial, prueba ~140 variantes y manda el resultado a Telegram.
STRATEGY=ema
RUN_MODE=backtest
TIMEFRAME=15m
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
STATE_DIR=/data

# Datos: mas dias = mas fiable (30-90). Simbolos: los mas liquidos
BACKTEST_DAYS=60
BACKTEST_SYMBOLS=40
BACKTEST_WORKERS=3
BACKTEST_MIN_N=50             # minimo de operaciones en train para considerar una variante

# Costes por lado (comision + slippage). Ajusta a tu ejecucion real
FEE_PCT=0.05
SLIP_PCT=0.02
