# ===== Servicio NUEVO en Railway (mismo repo): bot LCE en 15m =====
# Crea un segundo servicio desde el mismo repositorio, con su PROPIO Volume montado en /data.
STRATEGY=lce
TIMEFRAME=15m
HTF_INTERVAL=1h               # prueba tambien 4h con RUN_MODE=backtest
BOT_NAME=LCE 15m              # etiqueta en Telegram para distinguirlo del de 5m
TRADE_MODE=signals            # empieza en signals
RUN_MODE=bot                  # bot | backtest | dump
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
STATE_DIR=/data
# STATE_FILE se elige solo: lce_15m_state.json

# Universo / datos
SYMBOLS=ALL
MIN_QUOTE_VOLUME=5000000
MAX_SYMBOLS=150
CANDLES=800                   # ~8 dias de velas de 15m
SIGNAL_TIMEOUT_BARS=96        # 24 h de velas de 15m (se calcula solo si no lo pones)

# Estrategia: valores por defecto del Pine v8 (todo lo demas, igual que el bot de 5m).
# Los parametros en "velas" (COOLDOWN=6, PIV_LEN=10...) se mantienen, pero ahora cada vela dura 15 min.

# Costes: a 15m el ATR es mayor, asi que el stop (en % del precio) tambien y las comisiones pesan menos
FEE_PCT=0.05
SLIP_PCT=0.02

# Ejecucion (solo demo/live): mismas protecciones
MAX_POSITIONS=4
MAX_PER_SIDE=2
REGIME_FILTER=true
MAX_DAY_LOSS=3
MAX_CONS_LOSS=3
KILL_SWITCH=false
LIVE_CONFIRM=

# Antes de operar: RUN_MODE=backtest BACKTEST_DAYS=60 (usa TIMEFRAME=15m) y mira train/test
BACKTEST_DAYS=60
BACKTEST_WORKERS=3
