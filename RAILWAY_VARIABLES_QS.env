# ===== Servicio NUEVO en Railway (mismo repo) para la estrategia QS + SSMT + tCISD =====
# Crea un segundo servicio desde el mismo repositorio de GitHub, con su PROPIO Volume montado en /data.
STRATEGY=qs
TRADE_MODE=signals            # signals | demo | live  (empieza en signals)
RUN_MODE=bot                  # bot | backtest | dump
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
STATE_DIR=/data

# ===== Triada(s) correlacionada(s): 3 simbolos cada una, varias separadas por ';' =====
# El indicador original usa NQ/ES/YM. Por defecto aqui: BTC/ETH/SOL (ajusta a lo que liste BingX)
TRIADS=BTC-USDT,ETH-USDT,SOL-USDT
QS_INV2=false                 # activo inverso (p. ej. un indice inverso)
QS_INV3=false

# ===== Alineacion de cuartos =====
QS_SEQ=wd90                   # wd90 = Semanal-Diario-90m | mwd = Mensual-Semanal-Diario
QS_ALIGN=369_o_cadena         # 369_o_cadena | solo_369 | solo_cadena | 369_y_cadena | sin_filtro
QS_MIN_CHAIN=3
QS_BRIDGE=true
QS_FRI_Q4=false
QS_USE_MONTH=true
QS_USE_YEAR=false

# ===== SSMT (llave) y True Opens =====
QS_STAGE=daily                # daily | m90
QS_USE2=true
QS_REQ_DIV=false
QS_USE_TO=true
QS_MIN_TO=1

# ===== Gatillo y riesgo/objetivos =====
QS_MAX_WAIT=16
QS_SL_BUF=0.1
QS_MAX_RISK_ATR=8
QS_TP_MODE=ext137             # ext137 | rr
QS_FIB_EXT=1.37
QS_RR_FIXED=2.0
QS_MIN_RR=1.0

# ===== Backtest QS (RUN_MODE=backtest) y volcado (RUN_MODE=dump) =====
BACKTEST_DAYS=60
BACKTEST_WORKERS=3
BACKTEST_MIN_N=30
DUMP_SYMBOL=BTC-USDT
DUMP_DAYS=7

# ===== Ejecucion (solo demo/live): mismas protecciones que el bot LCE =====
MAX_POSITIONS=3
MAX_PER_SIDE=2
REGIME_FILTER=false           # la triada ya es BTC/ETH/SOL
MAX_DAY_LOSS=3
MAX_CONS_LOSS=3
KILL_SWITCH=false
LIVE_CONFIRM=
