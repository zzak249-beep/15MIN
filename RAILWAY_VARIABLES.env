# ===== Obligatorias =====
TRADE_MODE=signals            # signals (solo Telegram) | demo (VST sandbox) | live
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Solo para demo/live (permisos: Leer + Trade. NUNCA retiros)
BINGX_API_KEY=
BINGX_API_SECRET=
STATE_DIR=/data               # monta un Volume de Railway en /data

# ===== Herramientas =====
RUN_MODE=bot                  # bot | backtest | dump
PRESET=fiel                   # fiel | calidad | rupturas | reversion | majors
BACKTEST_DAYS=30
BACKTEST_SYMBOLS=40
BACKTEST_WORKERS=3
BACKTEST_MIN_N=30
DUMP_SYMBOL=BTC-USDT
DUMP_DAYS=3
# Filtros nuevos (0/false = apagado)
MIN_RISK_PCT=0
FIXED_TP=false
RV_MIN_VOL=0
RV_MIN_ADX=0
RV_MAX_ADX=0

# ===== Universo =====
SYMBOLS=ALL
MIN_QUOTE_VOLUME=5000000      # USDT 24h
MAX_SYMBOLS=150
NON_CRYPTO_PREFIXES=NCSK,NCFX,NCCO,NCSI   # pega aquí tu lista completa de la flota

# ===== Protecciones de ejecucion (demo/live) =====
MAX_PER_SIDE=2
REGIME_FILTER=true
REGIME_SYMBOL=BTC-USDT
MAX_SL_LIQ_FRAC=0.5
MAX_SL_PCT=0
KILL_SWITCH=false             # true = no abre operaciones nuevas
LIVE_CONFIRM=                 # poner SI para permitir TRADE_MODE=live

# ===== Riesgo =====
RISK_PCT=1.0
MAX_LEV=5
LEVERAGE=5
MAX_POSITIONS=4
MAX_DAY_LOSS=3                # % del equity (live exige > 0)
MAX_TRADES_DAY=12
MAX_CONS_LOSS=3
PAUSE_BARS=36

# ===== Estrategia (defaults = LCE v2 / v8 con todo apagado) =====
TIMEFRAME=5m
USE_HTF=true
HTF_INTERVAL=1h
USE_VOL=true
VOL_MULT=1.2
BODY_MULT=0.5
WICK_RATIO=0.35
USE_SLOPE=true
MIN_RR=1.2
RR_FALLBACK=2.0
SL_BUFFER=0.3
COOLDOWN=6
SIGNAL_TIMEOUT_BARS=288       # senal sin resolver -> expirada (no cuenta en win rate)
HEARTBEAT_HOURS=6
USE_BREAKOUT=true
USE_REVERSION=true
USE_SWEEP_SIG=false

# ===== Módulos opcionales (todos off, como en el Pine) =====
VOL_MODE=Multiplo             # Multiplo | Kernel
USE_ADX=false
USE_FLOW=false
USE_SQZ=false
USE_E200_DIR=false
USE_E200_EXT=false
USE_E200_RV=false
USE_E200_TP=false
REV_NEED_DIV=false
REV_NEED_SWEEP=false
USE_STRUCT_BO=false
USE_STRUCT_EXIT=false
USE_SESS_LVL=false            # barrido tambien del max/min de la sesion de referencia
SESS_LVL_UTC=0000-0800
USE_SCORE=false               # modo puntuacion en vez de filtros todo-o-nada
MIN_SCORE_BO=5                # de 8
MIN_SCORE_RV=2                # de 5
ADX_RANGE_MAX=25
SIZE_BY_SCORE=false           # tamano segun puntuacion
SIZE_MIN=0.5
SIZE_MAX=1.25
USE_PARTIAL=false
USE_BE=false
USE_TRAIL=false
TP1_R=1.0
TP1_PCT=50
TRAIL_ATR=2.0
RR_TRAIL_CAP=6.0
MAX_BARS=0
ZONE_MAX_AGE=0
MAX_RISK_ATR=0
TP_BUFFER=0
COST_MULT=0
FEE_PCT=0.05
SLIP_PCT=0.02                 # slippage por lado (%) solo para el R neto de las estadisticas
